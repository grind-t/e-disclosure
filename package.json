{
  "name": "@grind-t/e-disclosure",
  "version": "1.0.0",
  "homepage": "https://github.com/grind-t/e-disclosure#readme",
  "bugs": {
    "url": "https://github.com/grind-t/e-disclosure/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grind-t/e-disclosure.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "test:unit": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.unit.test.ts\"",
    "test:e2e": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.e2e.test.ts\"",
    "test": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "build": "tsdown",
    "pull:report": "node --experimental-transform-types scripts/pull-msfo-report.ts",
    "export:ratings": "node --experimental-transform-types scripts/export-ratings.ts"
  },
  "dependencies": {
    "content-disposition": "^3.0.0",
    "dayjs": "^1.11.23",
    "patchright": "^1.62.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsdown": "latest",
    "typescript": "latest",
    "zx": "^8.8.5"
  }
}
